# Copy this file to `.env` (same folder) and fill it in.
# NEVER commit `.env` - it contains secrets.

# GitHub MCP server (requires docker)
GITHUB_PERSONAL_ACCESS_TOKEN=

# Blender MCP server (only set this if Blender + blender-mcp are installed
# on this machine)
BLENDER_MCP_BIN=
BLENDER_PATH=

# Supabase MCP server (full remote URL, including project_ref)
# Important: always quote values containing &, ?, # etc., otherwise bash
# will treat them as shell metacharacters (e.g. & starts a background job).
SUPABASE_MCP_URL=
